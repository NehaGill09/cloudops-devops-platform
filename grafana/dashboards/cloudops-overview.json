{
  "title": "CloudOps API Overview",
  "uid": "cloudops-overview",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "10s",
  "panels": [
    {
      "id": 1,
      "title": "HTTP requests per second",
      "type": "timeseries",
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 0},
      "targets": [{"expr": "sum(rate(flask_http_request_total[5m]))", "legendFormat": "requests/sec", "refId": "A"}]
    },
    {
      "id": 2,
      "title": "Process memory",
      "type": "timeseries",
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 0},
      "targets": [{"expr": "process_resident_memory_bytes", "legendFormat": "resident bytes", "refId": "A"}]
    }
  ]
}
